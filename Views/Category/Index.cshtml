@model IEnumerable<DATN.Models.Category>

@{
    ViewData["Title"] = "Danh sách danh mục";
    var totalCategory = Model?.Count() ?? 0;
    var totalProduct = Model?.Sum(c => c.Products?.Count() ?? 0) ?? 0;
    string currentFilter = Context.Request.Query["searchString"];
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <!-- Thống kê tổng quát -->
    <div class="row mb-4">
        <div class="col-md-6 mb-2">
            <div class="card text-white bg-primary">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">Tổng danh mục</h5>
                        <p class="card-text fs-4 fw-bold mb-0">@totalCategory</p>
                    </div>
                    <i class="bi bi-tags fs-1"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-2">
            <div class="card text-white bg-success">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">Tổng sản phẩm</h5>
                        <p class="card-text fs-4 fw-bold mb-0">@totalProduct</p>
                    </div>
                    <i class="bi bi-box-seam fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tìm kiếm -->
    <form method="get" asp-controller="Category" asp-action="Index" class="mb-3 row g-3">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@currentFilter" class="form-control" placeholder="Nhập tên danh mục..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Tìm kiếm
            </button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Xóa lọc
            </a>
        </div>
    </form>

    <p>
        <a class="btn btn-success" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Tạo mới danh mục
        </a>
    </p>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">Hình ảnh</th>
                <th scope="col">Tên danh mục</th>
                <th scope="col">Số sản phẩm</th>
                <th scope="col" style="width:160px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.CategoryImage))
                        {
                            <img src="~/hinh/@item.CategoryImage" class="img-thumbnail" style="max-height:80px;" />
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Chưa có hình</span>
                        }
                    </td>
                    <td class="fw-semibold">@item.CategoryName</td>
                    <td>
                        <span class="badge bg-info text-dark">
                            @(item.Products?.Count() ?? 0) sản phẩm
                        </span>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.CategoryId">
                            <i class="bi bi-pencil-square"></i> Sửa
                        </a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.CategoryId">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
