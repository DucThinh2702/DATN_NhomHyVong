@model DATN.Models.Category

@{
    ViewData["Title"] = "Tạo mới danh mục";
}

<div class="main-content" id="mainContent">
    <div class="container mt-4">
        <h2>@ViewData["Title"]</h2>

        <form asp-action="Create" enctype="multipart/form-data" class="mt-3">
            <!-- Tên danh mục -->
            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
                <!-- Dòng nhắc nhỏ -->
                <small id="nameHint" class="form-text text-muted">
                    Tên danh mục không được vượt quá 100 ký tự.
                </small>
            </div>

            <!-- Hình ảnh -->
            <div class="mb-3">
                <label class="form-label">Hình ảnh</label>
                <input type="file" name="imageFile" class="form-control" onchange="previewImage(event)" />
                <span id="imageErrorMsg" class="text-danger"></span>

                <!-- Khung hiển thị ảnh -->
                <img id="imagePreview" src="#" alt="Xem trước ảnh" style="display:none; margin-top:10px; max-height:150px;" />
            </div>

            <!-- Nút -->
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Lưu
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Quay lại
            </a>
        </form>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
            // Bắt lỗi khi submit
            document.querySelector('form').addEventListener('submit', function (e) {
                let hasError = false;

                // Tên danh mục
                const nameInput = document.querySelector('input[name="CategoryName"]');
                const nameValue = nameInput.value.trim();
                const nameErrorSpan = document.querySelector('span[data-valmsg-for="CategoryName"]');
                nameErrorSpan.textContent = '';
                nameInput.classList.remove('is-invalid');

                if (nameValue === '') {
                    nameErrorSpan.textContent = 'Vui lòng nhập tên danh mục.';
                    nameInput.classList.add('is-invalid');
                    hasError = true;
                } else if (nameValue.length > 100) {
                    nameErrorSpan.textContent = 'Tên danh mục không được vượt quá 100 ký tự.';
                    nameInput.classList.add('is-invalid');
                    hasError = true;
                }

                // Ảnh
                const imageInput = document.querySelector('input[name="imageFile"]');
                const imageErrorSpan = document.getElementById('imageErrorMsg');
                imageErrorSpan.textContent = '';
                imageInput.classList.remove('is-invalid');

                if (imageInput.files.length === 0) {
                    imageErrorSpan.textContent = 'Vui lòng chọn hình ảnh.';
                    imageInput.classList.add('is-invalid');
                    hasError = true;
                }

                if (hasError) {
                    e.preventDefault();
                }
            });

            // Xem trước ảnh
            function previewImage(event) {
                const input = event.target;
                const preview = document.getElementById('imagePreview');
                const file = input.files[0];

                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    preview.src = "#";
                    preview.style.display = 'none';
                }
            }
        </script>
    }
</div>
