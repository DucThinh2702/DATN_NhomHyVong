@model DATN.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<div class="main-content" id="mainContent">
    <h1 class="mb-4">Thêm sản phẩm mới</h1>

    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- Tên sản phẩm -->
        <div class="mb-3">
            <label for="ProductName" class="form-label fw-bold">Tên sản phẩm</label>
            <input asp-for="ProductName" class="form-control" id="ProductName" placeholder="Nhập tên sản phẩm" />
            <span asp-validation-for="ProductName" class="text-danger"></span>
        </div>

        <!-- Mô tả -->
        <div class="mb-3">
            <label for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
            <textarea asp-for="Description" class="form-control" id="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="SalePrice" class="form-label fw-bold">Giá bán</label>
                <input asp-for="SalePrice" class="form-control" id="SalePrice" placeholder="Nhập giá bán" />
                <span asp-validation-for="SalePrice" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label for="OriginalPrice" class="form-label fw-bold">Giá gốc</label>
                <input asp-for="OriginalPrice" class="form-control" id="OriginalPrice" placeholder="Nhập giá gốc" />
                <span asp-validation-for="OriginalPrice" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="CategoryId" class="form-label fw-bold">Danh mục</label>
                @Html.DropDownListFor(model => model.CategoryId,
                         (SelectList)ViewBag.Categories,
                         "-- Chọn danh mục --", new { @class = "form-select", id = "CategoryId" })
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label for="Status" class="form-label fw-bold">Trạng thái</label>
                <input asp-for="Status" class="form-control" id="Status" value="Đang bán" placeholder="Nhập trạng thái" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="Material" class="form-label fw-bold">Chất liệu</label>
                <input asp-for="Material" class="form-control" id="Material" placeholder="Nhập chất liệu" />
                <span asp-validation-for="Material" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label for="ImageFile" class="form-label fw-bold">Ảnh sản phẩm</label>
                <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" required />
                <span class="text-danger field-validation-valid" data-valmsg-for="ImageFile" data-valmsg-replace="true"></span>
            </div>
        </div>
        <div class="row">
            <!-- Chọn màu -->
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold mb-0">Chọn màu:</label>
                    <a asp-controller="Colors" asp-action="Create" asp-route-returnUrl="/Products1/Create"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Thêm màu
                    </a>

                </div>
                <div class="checkbox-grid">
                    @foreach (var color in ViewBag.Colors)
                    {
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input color-checkbox"
                                   id="color_@color.ColorId"
                                   value="@color.ColorId"
                                   data-name="@color.ColorName" />
                            <label class="form-check-label" for="color_@color.ColorId">@color.ColorName</label>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-6 mb-3">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold mb-0">Chọn kích cỡ:</label>
                    <a asp-controller="Sizes" asp-action="Create" asp-route-returnUrl="/Products1/Create"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Thêm kích cỡ
                    </a>

                </div>
                <div class="checkbox-grid">
                    @foreach (var size in ViewBag.Sizes)
                    {
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input size-checkbox"
                                   id="size_@size.SizeId"
                                   value="@size.SizeId"
                                   data-name="@size.SizeName" />
                            <label class="form-check-label" for="size_@size.SizeId">@size.SizeName</label>
                        </div>
                    }
                </div>
            </div>
        </div>


        <!-- Bảng tổ hợp biến thể -->
        <div class="mt-4" id="variantTableContainer">
            <h4>Biến thể sản phẩm</h4>
            <table class="table table-bordered" id="variantTable">
                <thead>
                    <tr>
                        <th>Kích cỡ</th>
                        <th>Màu</th>
                        <th>Số lượng</th>
                        <th>Ảnh đại diện</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- JS sẽ render -->
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-primary"> <i class="fa-solid fa-file-export me-2"></i>Lưu sản phẩm</button>
        <a asp-controller="Products1" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle me-2"></i> Quay lại
        </a>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_vi.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // Khởi tạo Summernote cho mô tả
            $('#Description').summernote({
                height: 200,
                toolbar: [
                    ['style', ['bold', 'italic', 'underline', 'clear']],
                    ['font', ['strikethrough', 'superscript', 'subscript']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['insert', ['link']],
                    ['view', ['fullscreen', 'codeview']]
                ]
            });

            // Ghi đè thông báo mặc định input number
            $.extend($.validator.messages, {
                number: "Vui lòng nhập số lượng lớn hơn 0 và không nhập ký tự"
            });

            // rule: chỉ cho phép số
            $.validator.addMethod("onlyNumber", function (value, element) {
                if (this.optional(element)) return true;
                return $.isNumeric(value);
            }, "Vui lòng không nhập ký tự");

            // rule: số > 0
            $.validator.addMethod("greaterThanZero", function (value, element) {
                if (this.optional(element)) return true;
                return parseFloat(value) > 0;
            }, "Vui lòng nhập số lớn hơn 0");

            // rule: phải chọn ít nhất 1 màu
            $.validator.addMethod("requireColor", function () {
                return $('.color-checkbox:checked').length > 0;
            }, "Vui lòng chọn ít nhất một màu");

            // rule: phải chọn ít nhất 1 size
            $.validator.addMethod("requireSize", function () {
                return $('.size-checkbox:checked').length > 0;
            }, "Vui lòng chọn ít nhất một kích cỡ");

            // rule: giá gốc phải lớn hơn giá bán
            $.validator.addMethod("greaterThan", function (value, element, param) {
                const salePrice = parseFloat($(param).val());
                const originalPrice = parseFloat(value);
                if (isNaN(salePrice) || isNaN(originalPrice)) return true;
                return originalPrice > salePrice;
            }, "Giá gốc phải lớn hơn giá bán");

            // validate toàn form
            $("form").validate({
                ignore: [],
                rules: {
                    ProductName: { required: true, minlength: 10 },
                    Description: { required: true, minlength: 10 },
                    SalePrice: { required: true, onlyNumber: true, greaterThanZero: true },
                    OriginalPrice: { required: true, onlyNumber: true, greaterThanZero: true, greaterThan: "#SalePrice" },
                    CategoryId: { required: true },
                    Status: { required: true, minlength: 3 },
                    Material: { required: true, minlength: 5 },
                    ImageFile: { required: true, extension: "jpg|jpeg|png|gif" },
                    colorGroup: { requireColor: true },
                    sizeGroup: { requireSize: true }
                },
                messages: {
                    ProductName: {
                        required: "Vui lòng nhập tên sản phẩm",
                        minlength: "Tên sản phẩm phải ít nhất 10 ký tự"
                    },
                    Description: {
                        required: "Vui lòng nhập mô tả sản phẩm",
                        minlength: "Mô tả phải ít nhất 10 ký tự"
                    },
                    SalePrice: { required: "Vui lòng nhập giá bán" },
                    OriginalPrice: {
                        required: "Vui lòng nhập giá gốc",
                        greaterThan: "Giá gốc phải lớn hơn giá bán"
                    },
                    CategoryId: { required: "Vui lòng chọn danh mục" },
                    Status: { required: "Vui lòng nhập trạng thái" },
                    Material: {
                        required: "Vui lòng nhập chất liệu",
                        minlength: "Chất liệu phải ít nhất 5 ký tự"
                    },
                    ImageFile: {
                        required: "Vui lòng chọn ảnh sản phẩm",
                        extension: "Vui lòng chọn định dạng ảnh hợp lệ (jpg, jpeg, png, gif)"
                    },
                    colorGroup: { requireColor: "Vui lòng chọn ít nhất một màu" },
                    sizeGroup: { requireSize: "Vui lòng chọn ít nhất một kích cỡ" }
                },
                errorElement: "span",
                errorClass: "text-danger",
                errorPlacement: function (error, element) {
                    if (element.attr("name") === "colorGroup" || element.attr("name") === "sizeGroup") {
                        error.appendTo(element.closest(".mb-3"));
                    } else {
                        error.insertAfter(element);
                    }
                }
            });

            // input hidden để check nhóm màu & size
            $('<input>').attr({ type: 'hidden', name: 'colorGroup' }).appendTo('form');
            $('<input>').attr({ type: 'hidden', name: 'sizeGroup' }).appendTo('form');

            // Sinh bảng biến thể động
            function generateVariants() {
                const selectedColors = $('.color-checkbox:checked');
                const selectedSizes = $('.size-checkbox:checked');
                const tbody = $('#variantTable tbody');
                tbody.empty();

                if (selectedColors.length === 0 || selectedSizes.length === 0) return;

                let index = 0;
                selectedSizes.each(function () {
                    const sizeId = $(this).val();
                    const sizeName = $(this).data('name');
                    selectedColors.each(function () {
                        const colorId = $(this).val();
                        const colorName = $(this).data('name');
                        const row = `
                            <tr>
                                <td>${sizeName}
                                    <input type="hidden" name="variants[${index}].SizeId" value="${sizeId}" />
                                </td>
                                <td>${colorName}
                                    <input type="hidden" name="variants[${index}].ColorId" value="${colorId}" />
                                </td>
                                <td>
                                    <input type="number" name="variants[${index}].Stock"
                                           class="form-control variant-stock" min="0" required />
                                </td>
                                <td>
                                    <input type="file" name="variants[${index}].ImageFile"
                                           class="form-control variant-image" accept="image/*" required />
                                </td>
                            </tr>`;
                        tbody.append(row);
                        index++;
                    });
                });

                // Gán rule động cho input biến thể
                $(".variant-stock").each(function () {
                    $(this).rules("add", {
                        required: true,
                        onlyNumber: true,
                        greaterThanZero: true,
                        messages: {
                            required: "Vui lòng nhập số lượng lớn hơn 0 và không nhập ký tự"
                        }
                    });
                });
                $(".variant-image").each(function () {
                    $(this).rules("add", {
                        required: true,
                        messages: { required: "Vui lòng chọn ảnh" }
                    });
                });
            }

            $(document).on('change', '.color-checkbox, .size-checkbox', generateVariants);

            // SweetAlert hiển thị thông báo khi có TempData từ server
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'success',
                            title: '@TempData["SuccessMessage"]',
                            showConfirmButton: false,
                            timer: 2000
                        });
            </text>
        }
        });
    </script>
}

}


