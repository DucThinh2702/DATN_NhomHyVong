@model DATN.Models.ProductVariant

@{
    ViewData["Title"] = "Sửa biến thể sản phẩm";
}

<div class="main-content" id="mainContent">
    <h1 class="mb-4">Sửa biến thể sản phẩm</h1>

    <form asp-action="Edit" enctype="multipart/form-data" class="row g-3">
        <input type="hidden" asp-for="VariantId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- Sản phẩm -->
        <div class="col-md-4 mb-3">
            <label class="form-label">Sản phẩm</label>
            @Html.DropDownListFor(m => m.ProductId,
                     (IEnumerable<SelectListItem>)ViewBag.Products,
                     "-- Chọn sản phẩm --",
                     new { @class = "form-select" })
        </div>

        <!-- Màu sắc -->
        <div class="col-md-4 mb-3">
            <label class="form-label">Màu sắc</label>
            @Html.DropDownListFor(m => m.ColorId,
                     (IEnumerable<SelectListItem>)ViewBag.Colors,
                     "-- Chọn màu sắc --",
                     new { @class = "form-select" })
        </div>

        <!-- Kích thước -->
        <div class="col-md-4 mb-3">
            <label class="form-label">Kích thước</label>
            @Html.DropDownListFor(m => m.SizeId,
                     (IEnumerable<SelectListItem>)ViewBag.Sizes,
                     "-- Chọn kích thước --",
                     new { @class = "form-select" })
        </div>

        <!-- Mã SKU -->
        <div class="col-md-6 mb-3">
            <label class="form-label">Mã SKU</label>
            <input asp-for="Sku" class="form-control" />
        </div>

        <!-- Tồn kho -->
        <div class="col-md-3 mb-3">
            <label class="form-label">Tồn kho</label>
            <input asp-for="Stock" class="form-control" />
        </div>

        <!-- Trạng thái -->
        <div class="col-md-3 mb-3">
            <label class="form-label">Trạng thái</label>
            <input asp-for="Status" class="form-control" />
        </div>

        <!-- Giá -->
        <div class="col-md-6 mb-3">
            <label class="form-label">Giá bán</label>
            <input asp-for="SalePrice" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Giá gốc</label>
            <input asp-for="OriginalPrice" class="form-control" />
        </div>

        <!-- Ảnh -->
        <div class="mb-3">
            <label class="form-label">Chọn ảnh từ máy</label>
            <input type="file" name="ImageFile" class="form-control" onchange="previewImage(this)" />
            <input type="hidden" asp-for="ThumbnailImage" />

            <div class="mt-2">
                <img id="preview" src="@Model.ThumbnailImage" style="max-height: 120px;" class="border rounded" />
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Lưu thay đổi
            </button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            const preview = document.getElementById('preview');
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
