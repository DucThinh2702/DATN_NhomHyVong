@model DATN.Models.Color
@{
    ViewData["Title"] = "Xóa màu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<div class="main-content" id="mainContent">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white d-flex align-items-center">
            <i class="bi bi-trash me-2"></i>
            <h5 class="mb-0">Xóa màu</h5>
        </div>
        <div class="card-body">
            <p class="fs-5 mb-3">Bạn có chắc chắn muốn xóa màu này không?</p>
            <dl class="row">
                <dt class="col-sm-3 fw-bold">Mã màu</dt>
                <dd class="col-sm-9">@Model.ColorId</dd>

                <dt class="col-sm-3 fw-bold">Tên màu</dt>
                <dd class="col-sm-9">@Model.ColorName</dd>
            </dl>
            <hr />
            <form asp-action="Delete">
                <input type="hidden" asp-for="ColorId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill"></i> Xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
