@model IEnumerable<DATN.Models.Size>
@{
    ViewData["Title"] = "Danh sách kích cỡ";
}
<div class="main-content" id="mainContent">
<h2>Danh sách kích cỡ</h2>
<a asp-action="Create" class="btn btn-primary">Thêm mới</a>
<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên kích cỡ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SizeId</td>
                <td>@item.SizeName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SizeId" class="btn btn-warning">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.SizeId" class="btn btn-info">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.SizeId" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>